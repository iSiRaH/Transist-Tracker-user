# ==============================================================================
# Transit Tracker Mobile Application - Environment Configuration Template
# ------------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to create your local '.env' file:
#    cp .env.example .env
# 2. Update the values below to match your local setup or deployment.
# 3. NEVER commit the actual '.env' file to source control.
# ==============================================================================

# Backend API Host Base URL (without trailing slash)
# - Physical Android device over Wi-Fi: http://<YOUR_LOCAL_IP>:3000 (e.g., http://192.168.0.234:3000)
# - Android Emulator (AOSP / Google APIs): http://10.0.2.2:3000
# - iOS Simulator / Web / Desktop: http://localhost:3000
# - Remote / Production: https://api.transittracker.com
AUTH_BASE_URL=http://192.168.0.234:3000

# Auth Endpoint Paths
AUTH_LOGIN_PATH=/login
AUTH_SIGNUP_PATH=/signup
AUTH_ME_PATH=/me

# Third-party Services / API Keys (add your secret keys below)
# MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
