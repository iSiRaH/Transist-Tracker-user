# ==============================================================================
# Transit Tracker Mobile Application - Environment Configuration Template
# ------------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to create your local '.env' file:
#    cp .env.example .env
# 2. Update the values below to match your local setup or deployment.
# 3. NEVER commit the actual '.env' file to source control.
# ==============================================================================

# Backend API Host Base URL (without trailing slash)
# - Physical Android device over Wi-Fi: http://192.168.1.60:3000
# - Android Emulator (AOSP / Google APIs): http://10.0.2.2:3000
# - iOS Simulator / Web / Desktop: http://localhost:3000
# - Remote / Production: https://api.transittracker.com
AUTH_BASE_URL=http://localhost:3000

# Auth Endpoint Paths
AUTH_LOGIN_PATH=/user/login
AUTH_SIGNUP_PATH=/user/signup
AUTH_FORGOT_PASSWORD_PATH=/forgot-password
AUTH_RESET_PASSWORD_PATH=/reset-password
AUTH_ME_PATH=/me
AUTH_GOOGLE_PATH=/user/google

# Google OAuth2 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
# 1. Web Client ID: Create OAuth 2.0 Web application credential for ID token verification
GOOGLE_CLIENT_ID=your_google_web_client_id_here.apps.googleusercontent.com

# 2. Server Client ID for Android: Used by GoogleSignIn on Android devices
GOOGLE_SERVER_CLIENT_ID=your_google_server_client_id_here.apps.googleusercontent.com

# 3. iOS Client ID: For iOS app builds (from GoogleService-Info.plist or Cloud Console)
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id_here.apps.googleusercontent.com

# Third-party Services / API Keys (add your secret keys below)
# MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
